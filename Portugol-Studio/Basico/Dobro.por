programa
{
	
	funcao inicio()
	{
		inteiro num1 , dobro
		escreva("Escreva um número : ")
		leia (num1)
		dobro = num1 * 2
		escreva("\n")
		escreva("O seu dobro é :" ,dobro)	
	}
}
