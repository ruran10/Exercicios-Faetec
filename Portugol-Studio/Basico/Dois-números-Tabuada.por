programa
{
	
	funcao inicio()
	{
		real num1 , num2 , soma , subtracao , multi , div

		escreva("Escreva um número : ")
		leia(num1)
		escreva("\n")
		escreva("Escreva um  segundo número : ")
		leia(num2)

		soma = num1 + num2
		subtracao = num1 - num2
		multi = num1 * num2
		div = num1 / num2

		escreva("Soma = " , soma)
		escreva("\n")
		escreva("Subtração = " , subtracao)
		escreva("\n")
		escreva("Multiplicação = " , multi)
		escreva("\n")
		escreva("Divisão = " , div)
	}
}
