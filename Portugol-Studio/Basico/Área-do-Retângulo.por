programa
{
    funcao inicio()
    {
        real largura, altura, area

        escreva("Digite a largura do retângulo: ")
        leia(largura)
        
        escreva("Digite a altura do retângulo: ")
        leia(altura)

        area = largura * altura

        escreva("A área do retângulo é: ", area)
    }
}
