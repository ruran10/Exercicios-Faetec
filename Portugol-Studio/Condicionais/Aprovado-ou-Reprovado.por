programa
{
    funcao inicio()
    {
        real media

        escreva("Digite a média do aluno: ")
        leia(media)

        se (media >= 6.0)
        {
            escreva("Aprovado")
        }
        senao
        {
            escreva("Reprovado")
        }
    }
}
